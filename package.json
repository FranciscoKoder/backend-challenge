{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "description": "Serviço financeiro distribuído que processa transações de apostas (BET/WIN/LOSS/REFUND/ROLLBACK)",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run src/infrastructure/persistence/migrate.ts up",
    "migration:down": "bun run src/infrastructure/persistence/migrate.ts down",
    "migration:status": "bun run src/infrastructure/persistence/migrate.ts status",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration --timeout 60000",
    "test:concurrency": "bun test test/concurrency --timeout 120000",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:load": "bun run test/load/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/postgresql": "^6.6.17",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
