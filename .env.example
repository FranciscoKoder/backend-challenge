# HTTP
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wagering
DB_POOL_MAX=20

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_PREFIX=
SQS_AUTO_CREATE=true
SQS_MAX_RECEIVE_COUNT=5
SQS_CONSUMER_CONCURRENCY=10
SQS_WAIT_SECONDS=5

# Papéis do processo (todos ligados por padrão; desligue para escalar de forma assimétrica)
ENABLE_SQS_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_REFERENCE_WORKER=true

# Outbox
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_MS=500

# Referências fora de ordem (PENDING_REFERENCE)
PENDING_MAX_ATTEMPTS=8
PENDING_BASE_DELAY_MS=5000
PENDING_MAX_DELAY_MS=300000
PENDING_POLL_MS=1000

# Somente testes: derruba o processo depois do COMMIT e antes do ack
FAULT_CRASH_AFTER_COMMIT=false
